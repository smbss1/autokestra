{
  "name": "@autokestra/plugin-sdk",
  "version": "0.0.2",
  "description": "SDK for building plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist && bunx tsc -p tsconfig.build.json",
    "publish:check": "npm pack --dry-run",
    "publish:npm": "npm publish --access public",
    "prepublishOnly": "bun run build",
    "lint": "bunx eslint src/**/*.ts",
    "format": "bunx prettier --write src/**/*.ts",
    "test": "bun test"
  },
  "dependencies": {
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.2"
  }
}